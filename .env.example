# --- Đăng nhập giao diện web ---
# Chuỗi ngẫu nhiên dài (>= 32 ký tự) dùng ký cookie phiên. Đổi giá trị này sẽ đăng xuất tất cả.
SESSION_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Chuỗi bí mật tự đặt, dùng khi setWebhook (secret_token)
TG_SECRET=
# ID nhóm Telegram của team IT để nhận nhắc việc (số âm), có thể để trống
TG_GROUP_ID=

# --- Mô hình AI cho bot (chọn MỘT: điền GEMINI_API_KEY thì dùng Gemini, bỏ trống thì dùng Claude) ---
# Gemini: lấy khóa miễn phí ở https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Claude:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Firebase (service account, chỉ dùng phía server) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Google Sheets (bản chiếu nhật ký IT, tùy chọn) ---
# Có thể dùng chung service account Firebase hoặc tạo riêng
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
SHEET_ID=

# --- Bảo mật API quản trị / cron ---
ADMIN_KEY=
CRON_SECRET=

# --- Nhắc việc ---
# Phiếu ở bước "Điện toán xử lý" quá số giờ này (tính từ lúc TCTH điều phối) bị đánh dấu quá hạn
SLA_HOURS=24

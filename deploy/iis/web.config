<?xml version="1.0" encoding="utf-8"?>
<!--
  Site IIS "assets.icbv.com" (hoặc tên bạn chọn) = cổng vào của trang 704, dùng Windows Authentication (AD).
  Người đã đăng nhập Windows/AD vào thẳng, không nhập lại mật khẩu; IIS chuyển tiếp tên người dùng cho máy chủ 704
  qua header; máy chủ 704 tự tra nhóm AD để phân quyền.
  Trước khi dùng: (1) đổi CHANGE_ME_... thành SSO_PROXY_SECRET trong C:\704-assets\.env
                  (2) đổi địa chỉ máy chủ 704 ở <action url=...>
                  (3) làm các lệnh trong HUONG-DAN-IIS.md (ARR, allowedServerVariables)
  Chỉ tài khoản quản trị và IIS_IUSRS được đọc file này (có chứa khóa).
-->
<configuration>
  <system.webServer>
    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true">
          <providers>
            <clear />
            <add value="Negotiate" />
            <add value="NTLM" />
          </providers>
        </windowsAuthentication>
      </authentication>
    </security>
    <rewrite>
      <rules>
        <rule name="to-704" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <!-- luôn GHI ĐÈ, nên client tự gửi header giả cũng vô hiệu -->
            <set name="HTTP_X_REMOTE_USER" value="{LOGON_USER}" />
            <set name="HTTP_X_SSO_SECRET" value="CHANGE_ME_SSO_PROXY_SECRET" />
          </serverVariables>
          <action type="Rewrite" url="http://192.168.1.18:3000/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <!-- không để IIS giữ lại tiêu đề phản hồi gây cache nhầm người dùng -->
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-store" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>

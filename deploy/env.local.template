# 704-assets - cấu hình bản NỘI BỘ (Windows Server). install.ps1 tự điền các giá trị ngẫu nhiên.
DB_MODE=local
DATA_DIR=__DATA_DIR__
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
# Nội bộ chạy HTTP: tắt cờ Secure của cookie. Khi đưa lên HTTPS (IIS/Nginx) đổi thành 1.
COOKIE_SECURE=0
SESSION_SECRET=__SESSION_SECRET__
ADMIN_KEY=__ADMIN_KEY__
CRON_SECRET=__CRON_SECRET__
SLA_HOURS=24

# --- Tùy chọn: bot Telegram + AI. Máy chủ nội bộ dùng chế độ getUpdates (scripts\tg-poll.mjs), KHÔNG cần URL công khai. ---
# Điền TELEGRAM_BOT_TOKEN rồi chạy lại install.ps1 (hoặc setup-telegram.ps1) để bật bot.
TELEGRAM_BOT_TOKEN=
TG_SECRET=__TG_SECRET__
TG_GROUP_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Tùy chọn: đăng nhập bằng Active Directory (ICBV\tên). Bỏ trống LDAP_URL = chỉ dùng mật khẩu trong ứng dụng ---
LDAP_URL=
LDAP_DOMAIN=ICBV
# LDAP_UPN_SUFFIX=icbv.local
# LDAP_CA_FILE=C:\704-assets\ad-ca.crt
# LDAP_LOCAL_USERS=admin
# LDAP_AUTOCREATE=0
# --- Phân quyền theo nhóm AD (tùy chọn). Nhiều nhóm thì lấy quyền cao nhất; AD là nguồn phân quyền, đăng nhập lại là cập nhật ---
# LDAP_BASE_DN=dc=icbv,dc=com
# LDAP_ROLE_MAP=admin=704-Admin;tcth=704-TCTH;it=704-IT;manager=704-LDP;user=704-User
# LDAP_REQUIRE_GROUP=1
# LDAP_NESTED_GROUPS=0
# LDAP_DEPT_ATTR=department
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# --- Đăng nhập một lần (SSO) từ Portal. Bật bằng setup-sso.ps1 (tự sinh khóa) ---
# SSO_SECRET=
# SSO_ISSUER=icbv-portal
# SSO_MAX_AGE_S=120
# SSO_PROXY_SECRET=

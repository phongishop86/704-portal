# 704-assets - cấu hình bản NỘI BỘ (Windows Server). install.ps1 tự điền các giá trị ngẫu nhiên.
DB_MODE=local
DATA_DIR=__DATA_DIR__
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
# Nội bộ chạy HTTP: tắt cờ Secure của cookie. Khi đưa lên HTTPS (IIS/Nginx) đổi thành 1.
COOKIE_SECURE=0
SESSION_SECRET=__SESSION_SECRET__
ADMIN_KEY=__ADMIN_KEY__
CRON_SECRET=__CRON_SECRET__
SLA_HOURS=24

# --- Tùy chọn: bot Telegram + AI. Máy chủ nội bộ dùng chế độ getUpdates (scripts\tg-poll.mjs), KHÔNG cần URL công khai. ---
# Điền TELEGRAM_BOT_TOKEN rồi chạy lại install.ps1 (hoặc setup-telegram.ps1) để bật bot.
TELEGRAM_BOT_TOKEN=
TG_SECRET=__TG_SECRET__
TG_GROUP_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
